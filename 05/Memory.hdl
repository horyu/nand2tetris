// File name: projects/5/Memory.hdl
/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O. 
 * The chip facilitates read and write operations, as follows:
 *     Read:  out(t) = Memory[address(t)](t)
 *     Write: if load(t-1) then Memory[address(t-1)](t) = in(t-1)
 * In words: the chip always outputs the value stored at the memory 
 * location specified by address. If load=1, the in value is loaded 
 * into the memory location specified by address. This value becomes 
 * available through the out output from the next time step onward.
 * Address space rules:
 * Only the upper 16K+8K+1 words of the Memory chip are used. 
 * Access to address>0x6000 is invalid and reads 0. Access to any address
 * in the range 0x4000-0x5FFF results in accessing the screen memory 
 * map. Access to address 0x6000 results in accessing the keyboard 
 * memory map. The behavior in these addresses is described in the Screen
 * and Keyboard chip specifications given in the lectures and the book.
 */
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    Or16(a[0..14]= address, b= false, out[0..13]= addressRam);
    Or16(a[0..14]= address, b= false, out[0..12]= addressScreen);
    // (16384(=2^14) + 8192(=2^13)) - address -> zr= targetKeyboard, ng= invalidAddress
    ALU(x[13..14]= true, y[0..14]= address, zx= false, nx= true, zy= false, ny= false, f= true, no= true, out= ignore0, zr= targetKeyboard, ng= invalidAddress);
    // address - (16384(=2^14) - 1) -> ng= targetRam
    ALU(x[0..14]= address, y[0..13]= true, zx= false, nx= true, zy= false, ny= false, f= true, no= true, out[0..12]= ignore1a, zr= ignore1b, ng= targetRam);
    // shouldLoad = load & !invalidAddress
    Not(in= invalidAddress, out= invalidAddressNot);
    And(a= load, b= invalidAddressNot, out= shouldLoad);
    // targetScreen = shouldLoad & !targetRam
    Not(in= targetRam, out= targetRamNot);
    And(a= invalidAddressNot, b= targetRamNot, out= targetScreen);
    // loadScreen = shouldLoad & targetScreen
    And(a= shouldLoad, b= targetScreen, out= loadScreen);
    // loadRam = shouldLoad & targetRam
    And(a= shouldLoad, b= targetRam, out= loadRam);

    RAM16K(in= in, load= loadRam, address= addressRam, out= rsRam);
    Screen(in= in, load= loadScreen, address= addressScreen, out= rsScreen);
    Keyboard(out= rsKeyboad);

    Mux16(a= rsScreen, b= rsRam, sel= targetRam, out= o0);
    Mux16(a= o0, b= rsKeyboad, sel= targetKeyboard, out= o1);
    Mux16(a= o1, b= false, sel= invalidAddress, out= out);
}